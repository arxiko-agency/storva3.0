<%- include('partials/head', { ogImage: product.images[0] ? product.images[0].url : '' }) %>
<%- include('partials/header') %>
<div class="sf-wrap">
  <p class="sf-crumb"><a href="/store/<%= store.slug %>">← All products</a></p>
  <article class="sf-pdp" id="pdp">
    <div class="sf-gallery">
      <div class="sf-main-img">
        <% if (product.images[0]) { %><img id="pdp-main" src="<%= product.images[0].url %>" alt="<%= product.images[0].alt || product.title %>" width="800" height="800"><% } else { %><span class="sf-noimg big" aria-hidden="true"><%= product.title.charAt(0).toUpperCase() %></span><% } %>
      </div>
      <% if (product.images.length > 1) { %>
      <div class="sf-thumbs">
        <% product.images.forEach(function (im, i) { %><button type="button" class="sf-thumb<%= i === 0 ? ' on' : '' %>" data-img="<%= im.url %>" data-alt="<%= im.alt || product.title %>" aria-label="Show image <%= i + 1 %>"><img src="<%= im.url %>" alt="" loading="lazy"></button><% }) %>
      </div>
      <% } %>
    </div>
    <div class="sf-info">
      <% if (product.category) { %><p class="muted sf-cat"><%= product.category %></p><% } %>
      <h1><%= product.title %></h1>
      <p class="sf-pdp-price"><b id="pdp-price"><%= money(product.hasVariants ? product.priceFrom : product.price) %></b>
        <s class="muted" id="pdp-compare"<%= product.compareAtPrice && product.compareAtPrice > product.price && !product.hasVariants ? '' : ' hidden' %>><%= product.compareAtPrice ? money(product.compareAtPrice) : '' %></s></p>
      <p class="sf-stock" id="pdp-stock"></p>
      <% product.options.forEach(function (o, i) { %>
      <div class="sf-field">
        <label for="opt-<%= i %>"><%= o.name %></label>
        <select id="opt-<%= i %>" data-option="<%= o.name %>"><option value="">Choose <%= o.name.toLowerCase() %></option><% o.values.forEach(function (v) { %><option value="<%= v %>"><%= v %></option><% }) %></select>
      </div>
      <% }) %>
      <div class="sf-field">
        <label for="pdp-qty">Quantity</label>
        <div class="sf-qty"><button type="button" id="qty-minus" aria-label="Decrease quantity">−</button><input id="pdp-qty" type="number" inputmode="numeric" min="1" max="20" value="1"><button type="button" id="qty-plus" aria-label="Increase quantity">+</button></div>
      </div>
      <p class="err" id="pdp-err" role="alert"></p>
      <div class="sf-actions">
        <button class="sf-btn sf-btn-p" id="pdp-add" type="button">Add to cart</button>
        <a class="sf-btn sf-btn-g" id="pdp-buy" href="/store/<%= store.slug %>/cart">View cart</a>
      </div>
      <% if (store.whatsappNumber) { %><a class="sf-btn sf-btn-wa sf-wide" href="<%= waLink('Hi! I am interested in: ' + product.title) %>" target="_blank" rel="noopener">Ask about this on WhatsApp</a><% } %>
      <% if (product.description) { %><div class="sf-desc"><h2>Details</h2><p><%= product.description %></p></div><% } %>
    </div>
  </article>
  <% if (related.length) { %>
  <section class="sf-related"><h2>More from <%= store.name %></h2>
    <div class="sf-grid"><% related.forEach(function (p) { %><%- include('partials/product-card', { p: p }) %><% }) %></div>
  </section>
  <% } %>
</div>
<script type="application/json" id="product-data"><%- safeJson(product) %></script>
<%- include('partials/footer') %>
