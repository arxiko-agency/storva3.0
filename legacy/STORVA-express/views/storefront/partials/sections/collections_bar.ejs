<% if (collections.length) { %>
<section class="sf-sec sf-wrap" id="<%= sec.id %>">
  <% if (s.title && !browsing) { %><h2 class="sf-sec-title"><%= s.title %></h2><% } %>
  <nav class="sf-chips" aria-label="Collections">
    <a class="sf-chip<%= !query.collection ? ' on' : '' %>" href="/store/<%= store.slug %>#catalog">All</a>
    <% collections.forEach(function (c) { %><a class="sf-chip<%= query.collection === c.slug ? ' on' : '' %>" href="/store/<%= store.slug %>?collection=<%= encodeURIComponent(c.slug) %>#catalog"><%= c.name %><% if (s.showCounts !== false) { %> <span class="muted"><%= c.productCount %></span><% } %></a><% }) %>
  </nav>
  <% if (active && active.description) { %><p class="muted"><%= active.description %></p><% } %>
</section>
<% } %>
