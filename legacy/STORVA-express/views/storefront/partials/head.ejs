<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title><%= title %></title>
<% if (locals.noindex) { %><meta name="robots" content="noindex,nofollow"><% } %>
<meta name="description" content="<%= store.tagline || store.description || ('Shop at ' + store.name) %>">
<meta property="og:site_name" content="<%= store.name %>"><meta property="og:title" content="<%= title %>"><meta property="og:type" content="website">
<% if (locals.ogImage || store.logoUrl) { %><meta property="og:image" content="<%= locals.ogImage || store.logoUrl %>"><% } %>
<meta name="theme-color" content="<%= locals.themeColor || '#14122B' %>">
<link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<% if (locals.design) { %><% if (locals.fontHref) { %><link href="<%= fontHref %>" rel="stylesheet"><% } %><% } else { %><link href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,400;12..96,600;12..96,800&display=swap" rel="stylesheet"><% } %>
<link rel="stylesheet" href="/css/storefront.css">
<link rel="stylesheet" href="/css/storefront-theme.css">
<% if (locals.designCss) { %><style id="sf-design"><%- safeCss(designCss) %></style><% } %>
<link rel="stylesheet" href="/css/logo.css">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="icon" type="image/png" sizes="32x32" href="/images/favicon-32.png">
<link rel="apple-touch-icon" href="/images/apple-touch-icon.png">
</head>
<body data-slug="<%= store.slug %>" data-page="<%= page %>" class="<%= locals.bodyClass || '' %>">
<a class="skip" href="#main">Skip to content</a>
<% if (locals.isPreview) { %><div class="sf-preview-bar" role="note"><b>Draft preview</b> · Only you can see this. Publish it from the Designer to make it live.</div><% } %>
