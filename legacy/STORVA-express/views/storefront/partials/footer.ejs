</main>
<footer class="sf-foot">
  <div class="sf-wrap sf-foot-in">
    <div>
      <b><%= store.name %></b>
      <% if (store.address) { %><div class="muted"><%= store.address %></div><% } %>
      <% if (store.contactEmail) { %><div><a href="mailto:<%= store.contactEmail %>"><%= store.contactEmail %></a></div><% } %>
      <% if (store.whatsappNumber && locals.showWhatsapp !== false) { %><div><a href="<%= waLink('Hi! I have a question about your store.') %>" target="_blank" rel="noopener">Chat on WhatsApp</a></div><% } %>
    </div>
    <% if (locals.showBranding !== false) { %><a class="brand-logo badge sf-powered" href="/" aria-label="Powered by STORVA"><span class="logo-frame"><img src="/images/storva-logo.png" alt="STORVA" width="577" height="433" decoding="async" loading="lazy"></span></a><% } %>
  </div>
</footer>
<% if (store.whatsappNumber && locals.showWhatsapp !== false && locals.page !== 'checkout') { %><a class="sf-wa-float" href="<%= waLink('Hi! I have a question about your store.') %>" target="_blank" rel="noopener" aria-label="Chat on WhatsApp"><svg viewBox="0 0 24 24" width="26" height="26" aria-hidden="true"><path fill="currentColor" d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2Zm0 18.2c-1.5 0-3-.4-4.3-1.2l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2Zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.3.1-.2 0-.3 0-.4l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.7 11.8 11.8 0 0 0 4.5 4c1.7.7 2.3.8 3.2.6.5-.1 1.5-.6 1.7-1.2.2-.6.2-1.1.2-1.2-.1-.1-.3-.2-.5-.3Z"/></svg></a><% } %>
<div id="sf-toast" role="status" aria-live="polite"></div>
<script src="/js/storefront.js"></script>
</body>
</html>
