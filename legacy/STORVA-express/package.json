{
  "name": "storva-saas",
  "version": "1.0.0",
  "description": "WhatsApp-to-Web store builder SaaS (multi-tenant)",
  "main": "server.js",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node scripts/run-tests.js",
    "test:unit": "node scripts/run-tests.js unit",
    "test:integration": "node scripts/test-integration.js",
    "build:css": "tailwindcss -c tailwind.config.js -i src/styles/tailwind.input.css -o public/css/tailwind.css --minify",
    "backup": "node scripts/backup.js",
    "restore": "node scripts/restore.js",
    "check:env": "node scripts/check-env.js",
    "check:integrations": "node scripts/check-integrations.js"
  },
  "dependencies": {
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "ejs": "^3.1.10",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "mongoose": "^8.9.5",
    "morgan": "^1.10.0",
    "nodemailer": "^6.9.16",
    "qrcode": "^1.5.4"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "tailwindcss": "^3.4.17"
  }
}
