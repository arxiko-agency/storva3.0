# ---------- Core ----------
NODE_ENV=development
PORT=3000
# Public URL of the app, no trailing slash (e.g. https://yourapp.onrender.com).
# Must match the browser's address in production (cross-site POSTs are rejected by Origin). If you change PORT locally, change this too.
APP_URL=http://localhost:3000
BRAND_NAME=STORVA
SUPPORT_EMAIL=support@yourdomain.com
# Digits only with country code, e.g. 919876543210. Leave empty to hide the floating WhatsApp button.
SUPPORT_WHATSAPP=
# Optional social link shown in the footer, e.g. https://instagram.com/yourbrand
SOCIAL_INSTAGRAM=

# Stores one account may create (Module 3). Plan-based limits replace this in Module 8.
MAX_STORES_PER_USER=1

# Product images are stored on disk (Module 4). On Render use a persistent Disk and point this at its mount path.
UPLOAD_DIR=./uploads
MAX_PRODUCTS_PER_STORE=50
# Storefront abuse limits per IP (Module 5): orders per 10 minutes, cart/coupon checks per minute
CHECKOUT_RATE_LIMIT=20
QUOTE_RATE_LIMIT=60

# ---------- MongoDB Atlas ----------
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/storva?retryWrites=true&w=majority

# ---------- Auth (Module 2) ----------
# Both REQUIRED in production, 32+ characters each. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# JWT_SECRET keys the hash of session tokens (sessions are opaque DB-backed cookies, not JWTs).
JWT_SECRET=
OTP_PEPPER=
# Session lifetime in days (default 30)
SESSION_DAYS=30

# ---------- MSG91 SMS OTP (Module 2) ----------
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# (MSG91_SENDER_ID is not read by the app: with the v5 OTP API the sender comes from your DLT-approved template.)
MSG91_SENDER_ID=

# ---------- Email OTP via SMTP / Nodemailer (Module 2) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM="STORVA <no-reply@yourdomain.com>"

# ---------- Razorpay (Modules 6 and 8) ----------
# Set BOTH key id and secret (rzp_test_... for testing) to enable online payment at checkout; leave both empty for cash on delivery only.
# The secret stays on the server. Only the key id is ever sent to the browser.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret: any long random string; paste the same value in Razorpay Dashboard -> Webhooks (URL: https://<APP_URL host>/webhooks/razorpay).
RAZORPAY_WEBHOOK_SECRET=
# Optional: owner refund requests allowed per IP per minute (default 20)
REFUND_RATE_LIMIT=20
# Payment reconciliation: every RECONCILE_INTERVAL_MINUTES (min 5) the app asks Razorpay about online orders stuck "pending"/"failed" for at least
# RECONCILE_MIN_AGE_MINUTES (min 2) and about refunds stuck in progress, and fixes what it safely can. It only READS from Razorpay.
# Set RECONCILE_ENABLED=false on web instances if you run `node scripts/reconcile.js` from a cron job instead.
RECONCILE_ENABLED=true
RECONCILE_INTERVAL_MINUTES=15
RECONCILE_MIN_AGE_MINUTES=15
RECONCILE_BATCH=50

# Optional tuning (defaults shown; leave commented to keep them). Rate limits are per IP.
# LOG_HTTP=1                  # request logging in production (always on outside production)
# PAYMENT_RATE_LIMIT=60       # online-payment attempts per 10 minutes
# WEBHOOK_RATE_LIMIT=300      # Razorpay webhook calls per minute
# RECONCILE_RATE_LIMIT=20     # owner "Check with Razorpay" clicks per minute
# REFUND_RATE_LIMIT=20        # owner refund requests per minute
# ABANDON_CLEANUP_ENABLED=true  # cancel unpaid online orders and return their stock
# ABANDON_ORDER_MINUTES=120     # age before an unpaid online order counts as abandoned (minimum 30)
# ABANDON_INTERVAL_MINUTES=15   # how often the cleanup runs
# STOREFRONT_CSP=relaxed        # emergency escape hatch ONLY: restores the old script-src 'unsafe-inline' 'unsafe-eval' on /store pages

# ---------- Plans & billing (Module 8) ----------
# Days a paid plan keeps working after it expires (renewal reminders continue), then the store counts as Free.
PLAN_GRACE_DAYS=3
# PLAN_EXPIRY_ENABLED=true     # background job: plan expiry + renewal reminder emails
# BILLING_DEV_MODE=false       # outside production, with Razorpay unset, plans can be "bought" without paying (for testing). false disables it.
# Your own business details printed on the plan invoices STORVA issues to store owners:
PLATFORM_LEGAL_NAME=
PLATFORM_GSTIN=
PLATFORM_ADDRESS=

# ---------- AI (Module 9) ----------
# Google Gemini key (https://aistudio.google.com). Leave empty to hide the AI tools.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash
# GEMINI_TIMEOUT_MS=25000

# ---------- WhatsApp Cloud API (Modules 10 and 13) ----------
# The platform number (Meta Business -> WhatsApp -> API setup). Webhook URL in Meta: https://<APP_URL host>/webhooks/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
# App secret from Meta (App settings -> Basic). REQUIRED in production: every webhook call is checked with it (HMAC-SHA256).
WHATSAPP_APP_SECRET=
# The number shoppers/owners see, digits with country code, e.g. 919876543210
WHATSAPP_DISPLAY_NUMBER=
# WHATSAPP_GRAPH_VERSION=v21.0
# Approved message template names (messages sent outside the 24-hour chat window need approved templates) and their language:
# WA_TPL_NEW_ORDER=storva_new_order  WA_TPL_ORDER_CONFIRMED=storva_order_confirmed  WA_TPL_ORDER_UPDATE=storva_order_update
# WA_TPL_REFUND=storva_refund_processed  WA_TPL_LOW_STOCK=storva_low_stock  WA_TEMPLATE_LANG=en
# Key that encrypts stores' own WhatsApp tokens at rest: 64 hex characters. If unset it is derived from JWT_SECRET
# (then rotating JWT_SECRET makes stored tokens unreadable and stores must reconnect).
SECRETS_KEY=

# ---------- Notifications (Module 13) ----------
# Emails / WhatsApp messages are queued and sent by a background job with automatic retries.
# OUTBOX_ENABLED=true
# OUTBOX_INTERVAL_SECONDS=20

# ---------- Analytics (Module 14) ----------
# Visitors are counted without cookies using a daily-changing keyed hash. Optional separate key (defaults to JWT_SECRET).
# ANALYTICS_SECRET=

# ---------- Production hardening (Module 15) ----------
# Bearer token for detailed GET /api/ready (jobs, message queue, errors, memory). 16+ characters. Without it /api/ready only says ok/db.
HEALTH_TOKEN=
# Slack / Discord / any JSON webhook that receives { text } alerts for server errors, failed jobs and crashes (de-duplicated, max 30/hour).
ALERT_WEBHOOK_URL=
# Share rate limits across several app instances through MongoDB (memory = per instance).
RATE_LIMIT_STORE=memory
# Backups: node scripts/backup.js  (see README "Backups"). BACKUP_KEY (32+ characters) encrypts them; keep it somewhere safe.
BACKUP_DIR=./backups
BACKUP_KEY=
BACKUP_KEEP=14
# LOG_HTTP=json                # one JSON line per request in production (no IPs, no query strings)
# APP_CSP=relaxed              # emergency escape hatch ONLY: allows inline script on the landing page/dashboard again

# Automatic refunds: when a PAID ONLINE (Razorpay) order is cancelled, the full remaining amount is refunded to the buyer automatically.
# Failed attempts are retried with a growing back-off; after AUTO_REFUND_MAX_ATTEMPTS the owner is alerted and can still refund by hand.
# AUTO_REFUND_ENABLED=false goes back to owner-initiated refunds only. Needs RAZORPAY_KEY_ID / RAZORPAY_KEY_SECRET.
AUTO_REFUND_ENABLED=true
# AUTO_REFUND_MAX_ATTEMPTS=3        # automatic attempts per order (1-10)
# AUTO_REFUND_RETRY_MINUTES=15      # base back-off after a failed attempt (grows with every failure)
# AUTO_REFUND_VERIFY_MINUTES=5      # ask Razorpay for the real status of a refund that is still in progress after this long
# AUTO_REFUND_INTERVAL_MINUTES=5    # background sweep interval
# AUTO_REFUND_BATCH=50

# ---------- Added in the production-readiness pass ----------
# Check everything without sending anything:   npm run check:env   (offline)   |   npm run check:integrations   (live, read-only)

# Razorpay auto-renew (Razorpay Subscriptions). Off by default: prepaid plan purchases keep working either way.
# Turn on ONLY after Subscriptions is activated on your Razorpay account and the webhook also sends subscription.* events.
# RAZORPAY_SUBSCRIPTIONS_ENABLED=false

# MongoDB connection (defaults shown). The first connection is retried with backoff; a wrong password or malformed URI fails at once.
# MONGO_CONNECT_ATTEMPTS=5
# MONGO_SERVER_SELECTION_MS=10000
# MONGO_POOL_SIZE=20
# MONGO_SOCKET_TIMEOUT_MS=          # empty = driver default (no socket timeout)

# SMTP safety (defaults shown). Port 587 requires STARTTLS so the password is never sent in clear text.
# SMTP_CONNECTION_TIMEOUT_MS=10000
# SMTP_REQUIRE_TLS=true

# Scheduled backups run inside the app. ON by default in production when BACKUP_KEY is set; they refuse to run unencrypted in production.
# BACKUP_SCHEDULE_ENABLED=true
# BACKUP_INTERVAL_HOURS=24
# BACKUP_HOUR_IST=2                 # optional: start the daily run in this India-time hour (0-23)

# Boot-time production check: errors are only printed. ENV_STRICT=true makes them stop the server from starting.
# ENV_STRICT=false

# Other rate limits (per IP, defaults in code) and options that were already read by the code but not listed above:
# ABANDON_BATCH=50
# AI_RATE_LIMIT=
# BILLING_RATE_LIMIT=30
# DESIGN_RATE_LIMIT=
# WHATSAPP_ALLOW_UNSIGNED=false     # development only: accept unsigned WhatsApp webhooks. Ignored in production.

# ---- Affiliate & referral program (all optional; defaults shown) ----
# AFFILIATE_ENABLED=false closes the program (links stop tracking, no new commissions).
AFFILIATE_ENABLED=true
# Commission as a percent of what the referred customer pays for each plan payment (0-90).
AFFILIATE_COMMISSION_PERCENT=20
# How many plan payments per referred customer earn commission (1 = first payment only).
AFFILIATE_MAX_PAYMENTS=12
# Days a commission is held before it becomes payable (your refund window).
AFFILIATE_HOLD_DAYS=30
# Smallest payout an admin can record, in rupees.
AFFILIATE_MIN_PAYOUT_RUPEES=500
# How long a clicked referral link is remembered in the visitor's browser.
AFFILIATE_COOKIE_DAYS=30
# Hourly repair sweep for commissions missed after a crash. Set false to turn it off.
AFFILIATE_SYNC_ENABLED=true
