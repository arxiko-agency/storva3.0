# Browser-safe backend configuration (publishable values only).
VITE_SUPABASE_URL=https://your-project.example.com
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
VITE_SUPABASE_PROJECT_ID=your-project-ref

# Server-only values are NOT stored in .env in Lovable Cloud; they are managed as secrets.
# For self-hosting, set them in the hosting provider's secret store. See docs/ENVIRONMENT.md.
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# SUPABASE_SERVICE_ROLE_KEY=
# LOVABLE_API_KEY=
# LOVABLE_CRON_SECRET=
# GOOGLE_MAIL_API_KEY=
# WHATSAPP_API_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
